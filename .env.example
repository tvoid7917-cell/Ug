# Required
DISCORD_TOKEN=

# Recommended for instant slash-command updates while developing.
# Leave empty to register commands globally (global updates can take up to an hour).
DISCORD_GUILD_ID=

# Optional ticket configuration
BRAND_NAME=United Knights
BRAND_ICON_URL=
BRAND_URL=
BRAND_BANNER_URL=https://cdn.discordapp.com/attachments/1537505873230958645/1537846582794264706/IMG_4302.jpg?ex=6a8086bd&is=6a7f353d&hm=865e2f9feb38bc643eabe1abd314aacf3616556c24ea7bcf3a623db3b5a281cb&
TICKET_CATEGORY_ID=
STAFF_ROLE_ID=
TRANSCRIPT_CHANNEL_ID=
TICKET_DELETE_DELAY_MS=5000

# Railway provides PORT automatically. Local development can use 5000.
PORT=5000